<Window x:Class="HRCompanion.App.CaseBrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Case Brain source audit" Height="540" Width="860" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Case Brain source audit" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555"
                       Text="Normal meeting retrieval uses only ORDINARY + CURRENT sources. ACAS / Without Prejudice and HISTORICAL sources remain stored locally but are excluded from ordinary HR answers." />
        </StackPanel>

        <ListBox x:Name="SourcesList" Grid.Row="1" DisplayMemberPath="Display" />

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Mark ORDINARY" Click="MarkOrdinary_Click" />
            <Button Content="Mark ACAS / WP" Click="MarkRestricted_Click" />
            <Button Content="Mark CURRENT" Click="MarkCurrent_Click" />
            <Button Content="Mark HISTORICAL" Click="MarkHistorical_Click" />
            <Button Content="Delete source" Click="Delete_Click" />
            <Button Content="Refresh" Click="Refresh_Click" />
        </WrapPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#555" />
    </Grid>
</Window>
