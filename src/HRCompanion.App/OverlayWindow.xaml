<Window x:Class="HRCompanion.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Companion Overlay" Width="470" Height="360" Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" Left="40" Top="80">
    <Border Padding="14" Background="#FCFCFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="HR COMPANION" FontWeight="Bold" />
                    <TextBlock DockPanel.Dock="Right" Text="● READY" Foreground="#2F6F3E" HorizontalAlignment="Right" />
                </DockPanel>
                <Separator Margin="0,9" />
                <TextBlock Text="SAY" FontWeight="Bold" />
                <TextBlock x:Name="SayText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" FontSize="17" />
                <TextBlock Text="WATCH" Margin="0,16,0,0" FontWeight="Bold" Foreground="#8A5A00" />
                <TextBlock x:Name="WatchText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" />
                <TextBlock Text="ASK" Margin="0,16,0,0" FontWeight="Bold" Foreground="#245A8D" />
                <TextBlock x:Name="AskText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
