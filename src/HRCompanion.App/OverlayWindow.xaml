<Window x:Class="HRCompanion.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Companion Overlay" Width="470" Height="430" Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" Left="40" Top="80"
        ShowActivated="False" Focusable="False">
    <Border Padding="14" Background="#FCFCFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="HR COMPANION" FontWeight="Bold" />
                    <TextBlock x:Name="StatusIndicator" DockPanel.Dock="Right" Text="READY" Foreground="#2F6F3E" HorizontalAlignment="Right" />
                </DockPanel>
                <Separator Margin="0,9" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" Grid.Column="0" Content="◀ Previous" Padding="8,3" IsEnabled="False" Click="Previous_Click" />
                    <TextBlock x:Name="ViewIndicator" Grid.Column="1" Text="LIVE" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" Grid.Column="2" Content="Next ▶" Padding="8,3" IsEnabled="False" Click="Next_Click" />
                </Grid>
                <Button x:Name="RetryLastHrButton" Content="⚡ Retry last HR turn" Padding="10,5" Margin="0,0,0,12"
                        ToolTip="One-click fallback: regenerate assistance from the most recent transcribed HR turn without typing."
                        Click="RetryLastHr_Click" />
                <TextBlock Text="SAY" FontWeight="Bold" />
                <TextBlock x:Name="SayText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" FontSize="17" />
                <TextBlock Text="WATCH" Margin="0,16,0,0" FontWeight="Bold" Foreground="#8A5A00" />
                <TextBlock x:Name="WatchText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" />
                <TextBlock Text="ASK" Margin="0,16,0,0" FontWeight="Bold" Foreground="#245A8D" />
                <TextBlock x:Name="AskText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
