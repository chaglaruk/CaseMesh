<Window x:Class="HRCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Companion" Height="780" Width="940" MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="HR Companion" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,16" Foreground="#555" Text="Local case context + fast grounded meeting assistance. No account or sync. · build meeting-fix-8" />
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F7F8" BorderBrush="#CCD3D8" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Microsoft Teams (automatic)" FontWeight="SemiBold" />
                    <DockPanel Margin="0,5,0,0">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="9,4" Content="Refresh" Click="RefreshDevices_Click" />
                        <ComboBox x:Name="TeamsProcessBox" DisplayMemberPath="DisplayName" MinWidth="250" IsEnabled="False"
                                  ToolTip="Teams is detected automatically. The displayed PID is diagnostic only and is not used for live audio capture." />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Microphone" FontWeight="SemiBold" />
                    <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="DisplayName" Margin="0,5,0,0" MinWidth="220" />
                </StackPanel>

                <WrapPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="StartMeetingButton" MinWidth="96" MinHeight="32" Content="Start meeting" Click="StartMeeting_Click" />
                    <Button x:Name="StopMeetingButton" MinWidth="64" MinHeight="32" Content="Stop" Click="StopMeetingSafe_Click" IsEnabled="False" />
                    <Button x:Name="PauseUserMicButton" MinWidth="104" MinHeight="32" Margin="6,0,0,0"
                            Content="Pause my mic" Click="PauseUserMic_Click" IsEnabled="False"
                            ToolTip="Use this when you are muted in Teams or speaking privately. HR Companion otherwise hears the Windows microphone independently of Teams mute." />
                </WrapPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock x:Name="LiveStatusText" Text="MANUAL" FontWeight="Bold" Foreground="#555" />
                    <TextBlock Text="  Recent: " Foreground="#555" />
                    <TextBlock x:Name="RecentTranscriptText" Text="—" TextTrimming="CharacterEllipsis" MaxWidth="610" />
                    <TextBlock x:Name="LatencyText" Margin="12,0,0,0" Foreground="#555" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <TextBlock x:Name="AudioGuardText" Foreground="#8A5A00" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreflightText" Margin="0,4,0,0" Foreground="#555"
                               Text="Preflight: checking local dependencies..." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Case Brain" FontWeight="SemiBold" />
                    <TextBlock x:Name="DocumentCountText" Text="Loading…" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="Import files" Click="ImportFiles_Click" />
                    <Button Content="Import folder" Click="ImportFolder_Click" />
                    <Button Content="Import ACAS/WP" Click="ImportRestricted_Click"
                            ToolTip="Imports restricted ACAS / Without Prejudice material. It is excluded from normal HR-meeting retrieval." />
                    <Button Content="Review sources" Click="ReviewSources_Click" />
                    <Button Content="Import working context" Click="ImportWorkingContext_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,8">
                    <TextBlock Text="Manual fallback / rehearsal" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,8" Foreground="#555" TextWrapping="Wrap"
                               Text="Paste the latest HR turn here. This remains usable even if live audio is unavailable." />
                    <TextBox x:Name="HrTurnBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <Button x:Name="AssistButton" Margin="0,10,0,0" HorizontalAlignment="Left" Content="Get assistance" Click="Assist_Click" />

                    <TextBlock Margin="0,22,0,4" Text="API key" FontWeight="SemiBold" />
                    <TextBlock Foreground="#555" Text="Stored in Windows Credential Manager, not in the database." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <PasswordBox x:Name="ApiKeyBox" Width="360" />
                        <Button Margin="8,0,0,0" Content="Save key" Click="SaveKey_Click" />
                    </StackPanel>

                    <TextBlock Margin="0,22,0,4" Text="Meeting position / objective (optional)" FontWeight="SemiBold" />
                    <TextBlock Foreground="#555" TextWrapping="Wrap"
                               Text="Add a position or objective for this meeting only. It is sent as USER_POSITION context for this meeting, not stored as documentary evidence or a permanent Case Brain fact." />
                    <TextBox x:Name="ContextBox" Margin="0,8,0,0" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Use for this meeting" Click="SaveContext_Click" />
                </StackPanel>

                <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Latest assistance" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Margin="0,12,0,2" Text="HEARD" FontWeight="Bold" Foreground="#555" />
                        <TextBlock x:Name="LatestHrText" Text="—" TextWrapping="Wrap" Foreground="#555" />
                        <TextBlock Margin="0,14,0,2" Text="SAY" FontWeight="Bold" />
                        <TextBlock x:Name="SayText" Text="—" TextWrapping="Wrap" FontSize="16" />
                        <TextBlock Margin="0,18,0,2" Text="NEXT — DON'T SAY YET" FontWeight="Bold" Foreground="#4C657A" />
                        <TextBlock x:Name="NextCueText" Text="—" TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,2" Text="WATCH" FontWeight="Bold" Foreground="#8A5A00" />
                        <TextBlock x:Name="WatchText" Text="—" TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,2" Text="ASK" FontWeight="Bold" Foreground="#245A8D" />
                        <TextBlock x:Name="AskText" Text="—" TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,2" Text="SOURCES" FontWeight="Bold" />
                        <TextBlock x:Name="SourcesText" Text="—" TextWrapping="Wrap" Foreground="#555" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Show overlay" Click="ShowOverlay_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <StatusBar Grid.Row="4" Margin="0,16,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
