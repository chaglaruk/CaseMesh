<Window x:Class="CaseMesh.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaseMesh Overlay" Width="470" Height="430" Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" Left="40" Top="80">
    <Border Padding="14" Background="#FCFCFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="CaseMesh" FontWeight="Bold" />
                    <TextBlock DockPanel.Dock="Right" Text="● READY" Foreground="#2F6F3E" HorizontalAlignment="Right" />
                </DockPanel>
                <Separator Margin="0,9" />
                <TextBlock Text="SAY" FontWeight="Bold" />
                <TextBlock x:Name="SayText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" FontSize="17" />
                <TextBlock Text="WATCH" Margin="0,16,0,0" FontWeight="Bold" Foreground="#8A5A00" />
                <TextBlock x:Name="WatchText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" />
                <TextBlock Text="ASK" Margin="0,16,0,0" FontWeight="Bold" Foreground="#245A8D" />
                <TextBlock x:Name="AskText" Margin="0,4,0,0" Text="—" TextWrapping="Wrap" />
                <TextBlock Text="GROUNDING" Margin="0,16,0,0" FontWeight="Bold" />
                <TextBlock x:Name="EvidenceStatusText" Margin="0,4,0,0" Text="NO CASE EVIDENCE" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="SourcesText" Margin="0,3,0,0" Text="—" TextWrapping="Wrap" Foreground="#555" />
                <TextBlock x:Name="ConfidenceText" Margin="0,5,0,0" Text="Model self-rating: —" TextWrapping="Wrap" Foreground="#777" FontSize="11" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
